import AutoAnimate from "@formkit/auto-animate/marko"

static const SNIPPET = `import AutoAnimate from "@formkit/auto-animate/marko"

<let/items = [{ id: 1, text: "Mango" }, /* ... */]>

<ul/listRef>
  <for|item| of=items by="id">
    <li>\${item.text}</li>
  </for>
</ul>
<AutoAnimate parent=listRef/>`;

static const FRUIT = [
  "Mango", "Papaya", "Lychee", "Guava", "Jackfruit",
  "Rambutan", "Durian", "Pomelo", "Tamarind", "Sapota",
];

<let/items = [
  { id: 1, text: "Mango" },
  { id: 2, text: "Papaya" },
  { id: 3, text: "Lychee" },
]>
<let/nextId = 4>

<h2>List basics: add / remove / shuffle</h2>
<p class="lede">
  One tag, zero per-item work. The adapter animates additions, removals,
  and reorders of the list's direct children.
</p>

<div class="toolbar">
  <button onClick() {
    items = [...items, { id: nextId, text: FRUIT[(nextId - 1) % FRUIT.length] }];
    nextId++;
  }>Add item</button>
  <button onClick() {
    const next = [...items];
    for (let i = next.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [next[i], next[j]] = [next[j], next[i]];
    }
    items = next;
  }>Shuffle</button>
  <button onClick() {
    items = [...items].reverse();
  }>Reverse</button>
</div>

<ul/listRef class="demo-list">
  <for|item| of=items by="id">
    <li>
      ${item.text}
      <button onClick() {
        items = items.filter((it) => it.id !== item.id);
      }>Remove</button>
    </li>
  </for>
</ul>
<AutoAnimate parent=listRef/>

<pre class="snippet"><code>${SNIPPET}</code></pre>

<p class="hint">
  SSR check: view-source this page. The three initial <code>&lt;li&gt;</code>
  rows are in the server HTML — no client render pass produced them. The
  adapter attaches to that server-printed <code>&lt;ul&gt;</code> when Marko
  resumes.
</p>
